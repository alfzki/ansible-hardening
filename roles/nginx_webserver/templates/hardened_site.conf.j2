# ==============================================================================
# Hardened Nginx Virtual Host Configuration
# Mengamankan endpoint HTTP dan HTTPS dengan TLS modern, restriksi akses,
# validasi Host header, rate limiting, dan proteksi DoS
# ==============================================================================

# 1. HTTP Default Catch-All Listener (Port 80)
# Tolak permintaan dengan Host header tidak sah / asing (Cegah Host Header Injection & Open Redirect)
server {
    listen {{ webserver_http_port }} default_server;
    listen [::]:{{ webserver_http_port }} default_server;
    server_name _;

    server_tokens off;
    return 400;
}

# 2. HTTP Authorized Listener (Port 80) -> Pengalihan paksa (HTTP 301) ke HTTPS aman
server {
    listen {{ webserver_http_port }};
    listen [::]:{{ webserver_http_port }};
    server_name {{ [inventory_hostname, ansible_facts.get('default_ipv4', {}).get('address', ''), ansible_host, 'localhost', '""'] | unique | reject('equalto', '') | join(' ') }};

    server_tokens off;
    return 301 https://$host$request_uri;
}

# 3. HTTPS Default Catch-All Listener (Port 443)
# Tolak permintaan TLS dengan Host header asing / tidak sah
server {
    listen {{ webserver_https_port }} ssl default_server;
    listen [::]:{{ webserver_https_port }} ssl default_server;
    server_name _;

    server_tokens off;

    ssl_certificate {{ webserver_ssl_cert_dir }}/nginx-hardened.crt;
    ssl_certificate_key {{ webserver_ssl_key_dir }}/nginx-hardened.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 400;
}

# 4. HTTPS Authorized Listener (Port 443) -> TLS 1.2/1.3 hardened web server
server {
    listen {{ webserver_https_port }} ssl;
    listen [::]:{{ webserver_https_port }} ssl;
    server_name {{ [inventory_hostname, ansible_facts.get('default_ipv4', {}).get('address', ''), ansible_host, 'localhost', '""'] | unique | reject('equalto', '') | join(' ') }};

    root {{ webserver_web_root }};
    index index.html index.htm;

    # Sembunyikan versi server dari header respons HTTP
    server_tokens off;

    # Rate Limiting & Connection Limiting (Proteksi DoS & Brute Force)
    limit_req zone=req_limit_per_ip burst=20 nodelay;
    limit_conn conn_limit_per_ip 20;
    limit_req_status 429;
    limit_conn_status 429;

    # Konfigurasi Sertifikat SSL & DH Parameters
    ssl_certificate {{ webserver_ssl_cert_dir }}/nginx-hardened.crt;
    ssl_certificate_key {{ webserver_ssl_key_dir }}/nginx-hardened.key;
    ssl_dhparam /etc/nginx/dhparam.pem;

    # Hanya izinkan TLSv1.2 dan TLSv1.3 (Nonaktifkan SSLv2, SSLv3, TLSv1, TLSv1.1)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;

    # Optimasi Sesi SSL / TLS
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Security Headers (RFC 6797 HSTS & OWASP Best Practices)
    include /etc/nginx/snippets/security_headers.conf;

    # Pembatasan Metode HTTP (Hanya GET, POST, HEAD yang diizinkan)
    if ($request_method !~ ^(GET|HEAD|POST)$ ) {
        return 405;
    }

    # Proteksi berkas dan direktori tersembunyi (dotfiles seperti .git, .env)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Penanganan halaman error kustom yang aman (tanpa kebocoran informasi sistem)
    error_page 404 /404.html;
    location = /404.html {
        root {{ webserver_web_root }};
        internal;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root {{ webserver_web_root }};
        internal;
    }
}
